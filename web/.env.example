# Optional. Leave empty to use Vite's /api proxy → localhost:8080 in dev.
VITE_API_BASE_URL=

# Optional. Google Maps Embed API key for live Route map.
# Create in Google Cloud Console → enable "Maps Embed API" → restrict by HTTP referrer.
# Without this key, Route shows the map placeholder.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
